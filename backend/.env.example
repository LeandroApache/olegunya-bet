# Copy to .env and fill in
DATABASE_URL="postgresql://user:pass@localhost:5432/betting?schema=public"
JWT_ACCESS_SECRET="change-me"
ODDSPAPI_API_KEY=""
# Bookmaker slug from your OddsPapi plan (account bookmakers keys). Default: pinnacle+30
# ODDSPAPI_BOOKMAKER="pinnacle+30"
# Hockey OddsPapi sport id is 15 (Regular Time Result market 153).
# ODDSPAPI_SPORT_HOCKEY is no longer used for defaults — see odds-papi.sport-config.ts
